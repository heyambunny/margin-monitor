# Copy this file to .env and fill in real values. .env is gitignored and
# should never be committed.

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=billing_software
DB_USER=your_db_user
DB_PASSWORD=

# --- Backend API base URL (used by the Python/Streamlit-era config.py) ---
BASE_URL=http://localhost:8000

# --- JWT auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# --- Outbound email (Email Center) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_NAME=Billing Team
